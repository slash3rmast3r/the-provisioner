# =============================================================================
# debian-provision — File di configurazione esempio
# Copia su /root/provision-config.env e usa con:
#   CONFIG_FILE=/root/provision-config.env ./install.sh --all --non-interactive -y
# =============================================================================

# --- SMTP (condiviso da Monit, Logwatch, ecc.) ---
SMTP_ENABLED="yes"
SMTP_HOST="mail.overthecloud.it"
SMTP_PORT="587"
SMTP_TLS="starttls"
SMTP_USER="info@savinocarlo.it"
SMTP_PASSWORD="INSERISCI_PASSWORD_QUI"
SMTP_FROM="info@savinocarlo.it"

# --- Monit ---
MONIT_ADMIN_EMAIL="info@savinocarlo.it"
MONIT_CHECK_INTERVAL="60"
# Servizi: ssh, nginx, docker, filesystem, custom
MONIT_SERVICES="ssh,docker,filesystem"
# Solo se MONIT_SERVICES include "custom":
# MONIT_CUSTOM_NAME="myapp"
# MONIT_CUSTOM_PID="/var/run/myapp.pid"
# MONIT_CUSTOM_START="/bin/systemctl start myapp"
# MONIT_CUSTOM_STOP="/bin/systemctl stop myapp"

# --- Logwatch ---
LOGWATCH_EMAIL="info@savinocarlo.it"
LOGWATCH_DETAIL="Med"
LOGWATCH_RANGE="Yesterday"
LOGWATCH_SERVICES="All"
LOGWATCH_FORMAT="text"
LOGWATCH_CRON_HOUR="6"

# --- UFW / SSH ---
# Porta SSH (configura sshd, UFW, fail2ban e Monit)
# IMPORTANTE: apri la stessa porta nel firewall Lightsail / EC2 Security Group
UFW_SSH_PORT="54321"
UFW_ALLOW_HTTP="yes"
UFW_ALLOW_HTTPS="yes"
# TCP (default se omesso il protocollo): numeri separati da virgola
UFW_EXTRA_PORTS="25,110,143,465,587,995"
# UDP dedicato (53 DNS, 51820 WireGuard, ecc.)
UFW_EXTRA_UDP_PORTS="53,51820,67"
# Alternativa: tutto in UFW_EXTRA_PORTS con suffisso protocollo
# UFW_EXTRA_PORTS="25/tcp,110/tcp,143/tcp,465/tcp,587/tcp,995/tcp,53/both,51820/udp"

# --- Docker ---
DOCKER_INSTALL_COMPOSE="yes"
DOCKER_USERS="debian,admin,karlo"
